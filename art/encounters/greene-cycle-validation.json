  "rejectedCases": {
    "initialUnit": "The runtime mesh has exactly 150 cuboids; the original test mistakenly asserted >150. Corrected the test to the measured inventory.",
    "saveReload": "Appendage health could be negative immediately after an overkill hit but was clamped to zero on load. Production subtraction now clamps at zero so save/reload is identical.",
    "animatedMovementBox": "Replacing the parent's movement AABB with a posed body union let vanilla movement reinterpret that box as a new world origin. Receiving proxies now own animation bounds; root physics remains stable.",
    "nativeKnockback": {
      "failureAt": "First low-damage body arrow, after scene age 300",
      "observedPosition": [
        0.012021120393088483,
        81.02080000013113,
        -0.05878343960490262
      ],
      "expectedRoot": [
        0,
        81,
        0
      ],
      "fix": "Rooted Greene rejects push and knockback; the accepted-hit body overlay still plays."
    },
    "affine": "A nonuniform neck bone scale followed by a rotated cube is skewed, so orthogonal projection leaked up to 0.0385047 blocks beyond the old receiver. Affine inverse basis, face normals, and closest face/edge projection now retain the rendered surface.",
    "selfProjectile": "EncounterProjectile excluded old EncounterPart owners but omitted the new GreenePart. Once leftOwner became true outside the movement box, own appendages could pop the projectile. Explicit owning-part exclusion plus a native flying projectile test added.",
    "fixtures": [
      "Radio completed test now explicitly selects the UAV fallback by placing the helicopter support cooldown beyond the test. The normal Blackwatch radio prefers transport support.",
      "The pure recharge persistence test removes AI goals while leaving entity ticks active, so autonomous goal stop/cancel cannot modify its startup cooldown."
    ]
  },

  "clientContract": {
    "tick": "GreeneProjectileAudio.tick() at start of ClientTick.Post, before null/player/pause early returns.",
    "clear": "GreeneProjectileAudio.clear() plus own client LevelEvent.Unload hook; detects world identity changes itself.",
    "identity": "IdentityHashMap keyed by actual projectile object; level.getEntity(id)==projectile prevents channel retention on untracking/ID reuse. Ammo profile changes replace the entry.",
    "final": "Biomass stops immediately; existing fire voice enters one bounded release envelope. No new voice/restart for finished projectiles. Entity removal always stops immediately.",
    "pause": "Retains existing SoundManager handle and freezes envelope/retry state; Minecraft owns device pause/resume. Invalid entity/world still cleans up while paused.",
    "muteAndReload": "Mute releases channel, suppresses start/retry; unmute resumes only active projectiles. Backend missing/asset reload uses20 unpaused ticks before one retry, preserving envelope and seeded pitch.",
    "distance": "Out of proven maximum range stops and releases; retracking/reentry creates one fresh local voice. No replayed impact or launch cues.",
    "budget": "Nearest12 active/tailing voices, stable UUID tie order; tails count against budget and end on original entity teardown."
  },
  "adapters": [
    "Linear source-min/max attenuation is explicit MC presentation; native middleware distance curve/spread/reverb/Doppler are not reproduced.",
    "Fade durations are verified native values; linear ramp shape and immediate hard-stop on client unload/range/mute are MC lifecycle policy.",
    "MC mix gain .28 and12-voice nearest budget are explicit volume/performance limits, not source values.",
    "UUID-seeded pitch is stable through re-tracking/resource reload and retains source ranges, not native RNG sequence.",
    "Late tracking/reentry starts sample at its beginning with local fade; Minecraft sound API does not seek native playback phase.",
    "Foley derivative waveform source/license/hash/seam metrics are in greene-projectile-loop-foley.json and greene-projectile-loop-audio-LICENSE.md. No source P1 waveform imported."
  ],

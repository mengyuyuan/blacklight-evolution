  "evidence": [
    {
      "va": "0x106bde0e..0x106bde45",
      "meaning": "Loader reads u16 matrixType and u32 flag. Stored compensation byte is true only when matrixType == 1 and flag != 0."
    },
    {
      "va": "0x106e91e0",
      "meaning": "Pose evaluation calls local evaluation 0x106e8740, then hierarchy evaluation 0x106e7c70; the Pose vtable entries themselves are reference-counting/destruction, not evaluation."
    },
    {
      "va": "0x106e8746..0x106e8774",
      "meaning": "Local update requires dirty bit 1 and spaces == 3. Extended matrix path requires state bit 4; the alternate rigid path does not evaluate scale. The inspected compensation occurs in the extended nonzero-matrixType path."
    },
    {
      "va": "0x106e8790..0x106e8799",
      "meaning": "SkeletonData matrixType zero chooses the general auxiliary-transform path; nonzero branches to 0x106e8a29."
    },
    {
      "va": "0x106e8a29..0x106e8aed",
      "meaning": "Builds quaternion rotation basis. Own scale from PoseData+0x18 is broadcast sx/sy/sz over the three stored basis rows, equivalent to S_i * R_i in native row-vector convention."
    },
    {
      "va": "0x106e8af0..0x106e8afd",
      "meaning": "Builds homogeneous translation row (tx,ty,tz,1) in xmm1 before the compensation branch."
    },
    {
      "va": "0x106e8ade; 0x106e8b01..0x106e8b28",
      "meaning": "Only i > 0 and nonzero compensation byte enter the branch. Parent index comes from SkeletonData+0x38. Parent scale is read from the CURRENT PoseData+0x18 array, not parent world-matrix length or bind scale. divps computes its reciprocal."
    },
    {
      "va": "0x106e8b2b..0x106e8b4c",
      "meaning": "Forms (1/spx,1/spy,1/spz,0), then multiplies the three basis rows componentwise. Translation xmm1 is not read or modified by this branch."
    },
    {
      "va": "0x106e8b58..0x106e8b63",
      "meaning": "Stores compensated basis at local +0/+0x10/+0x20 and unchanged translation xmm1 at +0x30."
    },
    {
      "va": "0x106e7de4..0x106e7f22",
      "meaning": "Child local rows are combined with parent world rows and stored as child world: W_i = L_i * W_parent in native row-vector notation; transposed column notation is W_parent * L_i."
    },
    {
      "va": "0x10e54820; 0x10e54830; 0x10e54870",
      "meaning": "Raw PE constants independently read as (0,0,0,0), (1,1,1,1), and (0,0,0,1), respectively."
    }
  ],
  "equations": {
    "nativeRowLinear": "B_i = S_i * R_i * inverse(S_parent) when compensation is enabled; otherwise S_i * R_i.",
    "nativeRowTranslation": "L_i row 3 = (tx, ty, tz, 1), unchanged by inverse parent scale.",
    "columnLinear": "B_i = inverse(S_parent) * R_i * S_i.",
    "columnLocal": "L_i = T(t_i) * inverse(S_parent) * R_i * S_i; inverse(S_parent) here is homogeneous diagonal with bottom-right 1.",
    "columnWorld": "W_i = W_parent * L_i.",
    "warning": "Do not premultiply the complete already-translated local matrix by inverse(S_parent); that incorrectly scales t_i. Recompute reciprocal after channel/frame/action blending; blending precomputed reciprocals is not reciprocal of blended parent scale."
  },

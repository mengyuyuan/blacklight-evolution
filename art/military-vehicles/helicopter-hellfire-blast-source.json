  "runtimeLinks": [
    {
      "function": "0x100aace0",
      "finding": "CollisionHitTrack factory allocates CollisionHitAction; constructor 0x100aa890 installs vtable 0x10d9c5ec and stores the track at action+0x9c."
    },
    {
      "function": "0x1014bf80 / 0x1014bf90",
      "finding": "Track begin is +0xf0; duration is end(+0xf8) minus begin. Source contiguous intervals cover 0 through approximately 0.3 seconds."
    },
    {
      "function": "0x1014bba0 / 0x1014bb20 / 0x1014b740 / 0x1014b720",
      "finding": "Resolved registration setters identify useOriginatorToValidate as flag 0x40 at track+0x11c, useDamageOriginator as flag 0x10, timeBetweenHits at +0xf4, collisionCountMax at +0x104. Validation origin and damage origin are separate settings."
    },
    {
      "function": "0x100a4310",
      "finding": "Binds validation entity and CollisionActionBehaviour to action+0x20/+0x24. Only action+0x29 (useOriginatorToValidate) requests originator substitution. These four source tracks set it false, so validation history belongs to the missile, while damage attribution still uses its originator."
    },
    {
      "function": "0x100a3810 / 0x100a8ca0 / 0x100aa830",
      "finding": "Eligibility queries shared CollisionActionBehaviour with target handle and timeBetweenHits; the latter getter reads track+0xf4. Source SendOnlyToAIManager=false leaves history checks enabled."
    },
    {
      "function": "0x100654c0",
      "finding": "IsValidCollision (message type 0x1d/subtype 3) scans target-handle/age entries. New target is allowed while active count > 0. An existing target is rejected when timeBetweenHits < 0; otherwise its age must reach the requested interval."
    },
    {
      "function": "0x100a4bd0",
      "finding": "Update checks eligibility/arc and registers the contact at 0x100a500f..0x100a503a BEFORE applying damage via virtual call at 0x100a508c. A canceled hurt does not automatically permit a later ring retry."
    },
    {
      "function": "0x10065940 / 0x10065870",
      "finding": "RegisterCollision (type 0x1d/subtype 6) resets an existing age or appends target/zero age. Storage is bounded and can evict an oldest record; exact configured capacity remains undecoded."
    },
    {
      "function": "0x100a4970 / 0x100a3780 / 0x10065470",
      "finding": "Track start/end change shared active count. Ending a track does not itself immediately clear history."
    },
    {
      "function": "0x10065a80",
      "finding": "CollisionActionBehaviour update ages records, expires entries after 5 seconds (constant 0x10d9486c), and clears when active count is no longer positive."
    }
  ],
  "interpretation": {
    "sharedHistory": "The four contiguous Hit tracks bind to one missile CollisionActionBehaviour, have timeBetweenHits=-1, and contain no explicit final-state ClearCollisionRecord track. Static evidence supports one recorded contact per target across this burst. Minecraft uses a shared UUID contact set across all stages. Original frame scheduling and bounded-history capacity have not been executed/decoded.",
    "duration": "Destroy track at 3 seconds supports retaining the final-state lifetime. It does not by itself prove an original three-second smoke effect; the Minecraft cosmetic fade is authored to this lifetime.",
    "sound": "The final Sound track is at time 0 with trigger stop and patch #9cbe2961a184c73d. It is not evidence for playing that patch as an impact sound; the existing Minecraft impact cue remains an adaptation.",
    "undecoded": "Unknown1 values and numeric CollideWith=48 are preserved, without inventing enabled/disabled semantics or category labels."
  },

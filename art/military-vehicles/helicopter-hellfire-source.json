  "runtime": {
    "launch": {
      "function": "0x1046ac20",
      "evidence": [
        "0x1046aee9 reads profile initialVelocity (+0x68) and multiplies launch heading.",
        "0x1046af30 checks inheritSpawnerVelocity (+0x9c); 0x1046af8e..0x1046afc8 adds spawner velocity to the powered velocity vector.",
        "0x104675ca..0x104675e9 copies the launch velocity into the separate cold-launch vector."
      ]
    },
    "ignition": {
      "function": "0x10467660",
      "evidence": [
        "0x1046766f compares Javelin ignition age with ignitionTime.",
        "0x10467696..0x104676b3 applies cold gravity * dt to cold vertical velocity.",
        "0x104677b9..0x104677f8 advances position from cold velocity.",
        "0x1046791c..0x1046795f redirects the original powered velocity magnitude along heading when ignition time is crossed."
      ]
    },
    "tracking": {
      "function": "0x1046a0e0",
      "evidence": [
        "0x1046a1fc checks global missile age against trackingDelay (+0xa4).",
        "0x1046a4ee reads maxTurningVelocity (+0x7c).",
        "0x1046a510 reads interpolateMaxTurningVelocity (+0x91).",
        "0x1046a53f reads minDotBetweenHeadings (+0x98).",
        "0x1046a57c calls 0x101265b0; 0x1046a584..0x1046a589 stores permanent lock failure from its return value."
      ]
    },
    "lead": {
      "function": "0x101262f0 via 0x10126500",
      "equation": "r=target-position; c=r.r; b=2*r.targetVelocity; a=targetVelocity^2-currentMissileSpeed^2; D=b*b-4*a*c; t=2*c/(sqrt(D)-b); if D>0 and t>0, lead=target+targetVelocity*t; otherwise use direct point.",
      "adaptation": "Nonfinite/undefined roots fall back to direct point in Minecraft."
    },
    "turn": {
      "function": "0x101265b0",
      "evidence": [
        "0x101266fe..0x10126719 handles near-identical headings.",
        "0x1012671f..0x1012680f checks minDot and retries direct target direction when the intercept direction fails.",
        "0x10126819 calls import _CIacos, proving the angle limit is radians.",
        "0x10126848..0x10126878 caps angle by maxTurningVelocity * dt * currentSpeed/profileSpeed when interpolation is enabled.",
        "0x10126881..0x10126918 constructs and normalizes a cross-product axis and rotates the heading."
      ]
    },
    "friction": {
      "function": "0x10468430",
      "equation": "parallel=v.dot(heading); sideways=v-heading*parallel; v-=normalize(sideways)*min(length(sideways),friction*dt); friction+=airFrictionIncreaseRate*dt; v+=heading*clamp(profileSpeed-abs(parallel),-acceleration*dt,acceleration*dt).",
      "evidence": [
        "0x10468430..0x104684de separates parallel and sideways velocity.",
        "0x104684f6 reads dynamic friction and clamps sideways reduction.",
        "0x1046858a..0x1046859e increments friction by profile airFrictionIncreaseRate (+0x84).",
        "0x10468613..0x10468702 approaches configured speed with bounded acceleration.",
        "0x104683f0..0x10468411 initializes dynamic friction from profile airFriction (+0x80)."
      ]
    },
    "lifetime": {
      "function": "0x104699b0",
      "evidence": [
        "0x104699ea advances global missile age before the physics callback.",
        "0x10469a6a compares timeToLive (+0x78).",
        "0x104699f3..0x10469a36 computes squared displacement from launch position, not accumulated path length.",
        "Original below-Y75 distance uses profile distanceToLive; above Y75 uses 300. Minecraft uses explicit profile distance 175 rather than applying the original world-altitude threshold to unrelated Minecraft terrain."
      ]
    }
  },

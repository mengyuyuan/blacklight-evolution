  "runtimeLinks": [
    {
      "function": "0x1046c680",
      "finding": "Actual ordinary missile collision resolves the struck GameObject and calls0x1046a6f0 at0x1046c897. The final-state virtual callback at0x1046ce4c..0x1046ce5b follows accepted collision, independent of later FIG Hit timing."
    },
    {
      "function": "0x1046a6f0",
      "finding": "At0x1046a709 target is converted to a handle.0x1046a71d..0x1046a73f sends type0x1d/subtype6 RegisterCollision to the missile parent BEFORE direct damage.0x1046a851..860 fetches effective profile damage;0x1046a9d6 creates damage message and0x1046a9e7 sends it to struck target. Friendly-fire and impulse branches are separate; no claim they equal MC policies."
    },
    {
      "function": "0x1046fd60",
      "finding": "Reads profile+0x44 damageOnPlayer or+0x48 damageOnNPC and applies upgrade multiplier0x1046fce0. Selected70mm fields both60, prior audited profile. MC base remains60*.04=2.4 before existing armor/CombatScale/events."
    },
    {
      "function": "0x100aace0 / 0x100aa890 / 0x100a59f0 / 0x10a7d8e0",
      "finding": "HitTrack factory creates CollisionHitAction; base action initial time+0x10 is0, flag0x600 enables start/end callbacks. The constructor does not increment CollisionActionBehaviour active count."
    },
    {
      "function": "0x10a850a0 / 0x10a850b0",
      "finding": "Calls track virtualslot15 (+0x3c), which is the HitAction factory. Then trackslot9 (+0x24, Hit begin getter0x1014bf80) is added to action+0x10; slot10 (+0x28, duration getter0x1014bf90) goes to action+0x14. Adds action to timeline using0x10a7f6c0, which adds parent current time."
    },
    {
      "function": "0x10a7fc20",
      "finding": "Timeline increments parent time.0x10a7fcc6..0x10a7fcda compares current time with action+0x10 and skips pending action until due. First eligible start at0x10a7fd3b..0x10a7fd4b invokes action vtable+0x14, CollisionHitAction start0x100a4970."
    },
    {
      "function": "0x100a4970 / 0x10065470",
      "finding": "HitAction start obtains the missile CollisionActionBehaviour and sends type0x1d/subtype2 active=true at0x100a4a08..0x100a4a1a. Active count increments only when the scheduled Hit starts; end decrements without itself clearing history."
    },
    {
      "function": "0x10065940 / 0x10065870 / 0x10065a80",
      "finding": "Direct RegisterCollision stores target and enables behavior update. Update clears history when active count<=0 (0x10065ae4..0x10065b0c).70mm has only its two final Hit tracks, both delayed. Thus the inactive.433s gap clears direct-contact history before first Hit; it must not permanently exclude the direct target from the later area attempt."
    },
    {
      "function": "0x100a4310 / 0x100654c0 / 0x100a4bd0",
      "finding": "Both Hit tracks use missile validation entity (UseOriginatorToValidate=false), shared history and TimeBetweenHits=-1. Existing target is ineligible; contact is recorded before hurt. Static evidence supports one area contact across the contiguous2/6-radius burst, even if hurt is canceled. Exact original frame-order/capacity remains unexecuted."
    },
    {
      "function": "0x10468b80",
      "finding": "Final transition is one-shot via byte+0xb9, sends final message and changes collision/physics state. Source final Destroy time1 establishes one-second entity timeline, separately from original impact effect identity."
    }
  ],
  "minecraftMapping": {
    "direct": "Keep ordinary native direct contact2.4 and existing actual hull/PvP/owner/crew/event rules. Replace immediate generic area loops with a persistent typed aircraft blast. No artificial invulnerability clearing or forced hurt success.",
    "damageStages": [
      {
        "tickRange": [
          0,
          8
        ],
        "radius": 0,
        "mcBaseDamage": 0
      },
      {
        "tickRange": [
          9,
          9
        ],
        "radius": 2,
        "sourceDamage": 100,
        "mcBaseDamage": 4
      },
      {
        "tickRange": [
          10,
          11
        ],
        "radius": 6,
        "sourceDamage": 50,
        "mcBaseDamage": 2
      }
    ],
    "time": "Ceiling of source13/30,14/30,17/30 seconds to20Hz gives9,10,12 ticks. No area damage before9; no area damage at12 or later. Destroy at20 ticks. Quantization is explicit, not original-engine bit equivalence.",
    "contact": "Delayed rings begin fresh after the source inactive gap and share one UUID contact set. Prior direct contact may receive one later area attempt. Ordinary MC hurt immunity can reduce/reject that attempt; vehicle armor and infected CombatScale stay authoritative.",
    "save": "BlastWave Version2 persists explicit weapon ID and its age/contact set; Version1 existing Hellfire saves load as Hellfire only. Unknown/missing/ambiguous version-profile combination fails closed. Age is bounded by profile20/60. World elapsed time skips past stages; stale/rollback state expires instead of replaying.",
    "entity": "Reuse existing invisible stable hellfire_blast entity ID for persistent aircraft timelines, with weapon identity stored in wave. No new entity or per-tick packet; actual cosmetic receipt uses weapon14.",
    "presentation": "One existing immediate impact flash/smoke/sound receipt (native collision already has immediate effects), then authored radial streaks appear9..12 with radius2->6, fade ends20. Original FX asset identity is not claimed. Protocol75/35 keeps paired builds aligned.",
    "world": "Existing permission-controlled once-only radius4 block blast remains separate from Hit radius6. Source WorldDamage directional offset/distance and ThreatBall are recorded, not treated as permission to expand terrain destruction."
  },
  "limits": [
    "Exact original damage-system invulnerability, friendly fire factors.2/.05/0, transformation multiplier, impulse units, CollideWith48 category meaning and WorldDamage/ThreatBall are not ported as raw values.",
    "Area history is unbounded in-memory UUID set with existing4096 save guard, unlike the source bounded/evicting contact buffer whose configured capacity remains undecoded.",
    "Original source scheduler was statically analyzed, not executed. Direct-record clear is supported by complete scheduling/active-count/update chain; original timing between contiguous Hit end/start remains an explicit runtime inference.",
    "Original FX and audio identities, active AI rapid controller, complete weighted maneuvers, original model topology and broader whole-project goal remain open."
  ]
}

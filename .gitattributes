* text=auto
*.png binary
*.jar binary
*.nbt binary
# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# Keep the shell wrapper executable by bash on Linux CI.
gradlew text eol=lf

# Preserve the checked motion/profile bytes on Windows and Linux checkouts.
art/motion-profile/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
art/motion-profile/*.data -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
